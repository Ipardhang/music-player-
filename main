    artImg: document.getElementById('artImg'),
    artGlyph: document.getElementById('artGlyph'),
    title: document.getElementById('songTitle'),
    artist: document.getElementById('songArtist'),
    status: document.getElementById('playerStatus'),
    seek: document.getElementById('seek'),
    curTime: document.getElementById('curTime'),
    durTime: document.getElementById('durTime'),
    playBtn: document.getElementById('playBtn'),
    playIcon: document.getElementById('playIcon'),
    pauseIcon: document.getElementById('pauseIcon'),
    prevBtn: document.getElementById('prevBtn'),
    nextBtn: document.getElementById('nextBtn'),
    shuffleBtn: document.getElementById('shuffleBtn'),
    repeatBtn: document.getElementById('repeatBtn'),
    volume: document.getElementById('volume'),
    trackList: document.getElementById('trackList'),
    trackCount: document.getElementById('trackCount'),
    autoplayLabel: document.getElementById('autoplayLabel'),
    autoplayState: document.getElementById('autoplayState'),
    fileUpload: document.getElementById('fileUpload'),
    searchToggleBtn: document.getElementById('searchToggleBtn'),
    searchBar: document.getElementById('searchBar'),
    searchInput: document.getElementById('searchInput'),
    searchGoBtn: document.getElementById('searchGoBtn'),
    searchResults: document.getElementById('searchResults'),
    spotifyBtn: document.getElementById('spotifyBtn'),
    spotifyBtnLabel: document.getElementById('spotifyBtnLabel'),
  };

  // ---- persistence (IndexedDB): keeps uploaded files and online adds across reloads ----
  const DB_NAME = 'musicPlayerLibrary';
  const STORE_NAME = 'tracks';
  let dbPromise = null;

  function openDB(){
    if(dbPromise) return dbPromise;
    dbPromise = new Promise((resolve, reject) => {
      if(!('indexedDB' in window)){ reject(new Error('IndexedDB unavailable')); return; }
      const req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        if(!db.objectStoreNames.contains(STORE_NAME)){
          db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
        }
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
    return dbPromise;
  }

  async function dbAdd(item){
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readwrite');
      const req = tx.objectStore(STORE_NAME).add(item);
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function dbDelete(id){
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).delete(id);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  async function dbGetAll(){
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readonly');
      const req = tx.objectStore(STORE_NAME).getAll();
      req.onsuccess = () => resolve(req.result || []);
      req.onerror = () => reject(req.error);
    });
  }

  function setStatus(message, isError = false){
    if(!el.status) return;
    el.status.textContent = message || '';
    el.status.style.color = isError ? '#ff8a90' : 'var(--text-faint)';
  }

  function formatTime(sec){
    if(!isFinite(sec) || sec < 0) return "0:00";
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function pad(n){ return n.toString().padStart(2, '0'); }

  function escapeHtml(str){
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function parseFileName(name){
    const withoutExt = name.replace(/\.[^/.]+$/, '');
    const parts = withoutExt.split(/\s*-\s*/);
    if(parts.length >= 2){
      return { artist: parts[0].trim(), title: parts.slice(1).join(' - ').trim() };
    }
    return { artist: "Your library", title: withoutExt.trim() };
  }

  function renderPlaylist(){
    el.trackList.innerHTML = '';
    tracks.forEach((t, i) => {
      const row = document.createElement('div');
      row.className = 'track-item' + (i === currentIndex ? ' active' : '');
      row.style.setProperty('--t-a', t.colors[0]);
      row.style.setProperty('--t-b', t.colors[1]);
      row.innerHTML = `
        <div class="track-thumb">
          ${t.artworkUrl ? `<img src="${escapeHtml(t.artworkUrl)}" alt="">` : ''}
          ${i === currentIndex && isPlaying ? `<div class="track-eq-wrap"><span class="track-eq"><span></span><span></span><span></span></span></div>` : ''}
        </div>
        <div class="track-info">
          <div class="t-title">${escapeHtml(t.title)}</div>
          <div class="t-artist">${escapeHtml(t.artist)}</div>
        </div>
        ${t.spotify ? '<span class="track-source" style="color:var(--spotify-green);">Spotify</span>' : (t.online ? '<span class="track-source">Preview</span>' : (t.local ? '<span class="track-source">Yours</span>' : ''))}
        <span class="track-dur" data-dur="${i}">${t.durationMs ? formatTime(t.durationMs / 1000) : '--:--'}</span>
        ${(t.local || t.online || t.spotify) ? `<button class="remove-btn" data-remove="${i}" aria-label="Remove track" title="Remove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>` : ''}
      `;
      row.addEventListener('click', (e) => {
        if(e.target.closest('.remove-btn')) return;
        loadTrack(i, true);
      });
      const removeBtn = row.querySelector('.remove-btn');
      if(removeBtn){
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          removeTrack(i);
        });
      }
      el.trackList.appendChild(row);
    });
    el.trackCount.textContent = tracks.length ? `${currentIndex+1} of ${tracks.length}` : '0 of 0';
  }

  function applyArtColors(colors){
    el.art.style.setProperty('--art-a', colors[0]);
    el.art.style.setProperty('--art-b', colors[1]);
    el.backdrop.style.setProperty('--art-a', colors[0]);
    el.backdrop.style.setProperty('--art-b', colors[1]);
  }

  function updateArtwork(t){
    applyArtColors(t.colors);
    if(t.artworkUrl){
      el.artImg.src = t.artworkUrl;
      el.artImg.style.display = 'block';
      el.artGlyph.style.display = 'none';
    } else {
      el.artImg.removeAttribute('src');
      el.artImg.style.display = 'none';
      el.artGlyph.style.display = 'flex';
    }
  }

  function loadTrack(index, autoplay){
    if(tracks.length === 0) return;
    currentIndex = (index + tracks.length) % tracks.length;
    const t = tracks[currentIndex];
    setStatus('');

    // stop whichever source was previously active
    if(!audio.paused) audio.pause();
    if(spotifyPlayer) spotifyPlayer.pause().catch(() => {});
    stopSpotifyPolling();
    lastSpotifyPosition = 0;

    if(!t.spotify){
      audio.src = t.src;
    }
    el.title.textContent = t.title;
    el.artist.textContent = t.artist;
    updateArtwork(t);
    el.seek.value = 0;
    el.seek.style.setProperty('--fill', '0%');
    el.curTime.textContent = "0:00";
    el.durTime.textContent = t.durationMs ? formatTime(t.durationMs / 1000) : "0:00";
    renderPlaylist();
    if(autoplay){
      if(t.spotify){
        playSpotifyTrack(t).then(ok => {
          if(!ok) setStatus('Spotify could not start this track.', true);
          setPlaying(ok);
        });
      } else {
        audio.play().then(() => setPlaying(true)).catch(() => {
          setPlaying(false);
          setStatus('This track could not be played. Check the file or connection.', true);
        });
      }
    }
  }

  function setPlaying(playing){
    isPlaying = playing;
    el.playIcon.style.display = playing ? 'none' : 'block';
    el.pauseIcon.style.display = playing ? 'block' : 'none';
    el.art.classList.toggle('spinning', playing);
    el.playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    renderPlaylist();
    const t = tracks[currentIndex];
    if(t && t.spotify){
      if(playing) startSpotifyPolling(); else stopSpotifyPolling();
    }
  }

  el.playBtn.addEventListener('click', () => {
    if(tracks.length === 0) return;
    const t = tracks[currentIndex];
    if(t.spotify){
      if(isPlaying){
        spotifyPlayer && spotifyPlayer.pause();
      } else {
        playSpotifyTrack(t).then(ok => setPlaying(ok));
      }
    } else {
      if(isPlaying){
        audio.pause();
        setPlaying(false);
      } else {
        audio.play().then(() => setPlaying(true)).catch(() => {
          setPlaying(false);
          setStatus('This track could not be played. Check the file or connection.', true);
        });
      }
    }
  });

  el.nextBtn.addEventListener('click', () => goNext(true));
  el.prevBtn.addEventListener('click', () => {
    const t = tracks[currentIndex];
    const pos = t.spotify ? lastSpotifyPosition / 1000 : audio.currentTime;
    if(pos > 3){
      if(t.spotify && spotifyPlayer){ spotifyPlayer.seek(0); }
      else { audio.currentTime = 0; }
    } else {
      loadTrack(currentIndex - 1, isPlaying);
    }
  });

  function goNext(forcePlay){
    if(tracks.length === 0) return;
    let next;
    if(shuffleOn && tracks.length > 1){
      const candidates = tracks.map((_, i) => i).filter(i => i !== currentIndex && !shuffleHistory.includes(i));
      if(candidates.length === 0) shuffleHistory = [];
      const pool = candidates.length ? candidates : tracks.map((_, i) => i).filter(i => i !== currentIndex);
      next = pool[Math.floor(Math.random() * pool.length)];
      shuffleHistory.push(next);
      if(shuffleHistory.length >= tracks.length) shuffleHistory.shift();
    } else {
      next = (currentIndex + 1) % tracks.length;
    }
    loadTrack(next, forcePlay !== undefined ? forcePlay : isPlaying);
  }

  el.shuffleBtn.addEventListener('click', () => {
    shuffleOn = !shuffleOn;
    shuffleHistory = [];
    el.shuffleBtn.classList.toggle('active', shuffleOn);
  });

  el.repeatBtn.addEventListener('click', () => {
    repeatOn = !repeatOn;
    el.repeatBtn.classList.toggle('active', repeatOn);
  });

  el.autoplayLabel.addEventListener('click', () => {
    autoplayOn = !autoplayOn;
    el.autoplayState.textContent = autoplayOn ? 'On' : 'Off';
  });

  audio.addEventListener('error', () => {
    if(tracks[currentIndex] && !tracks[currentIndex].spotify){
      setPlaying(false);
      setStatus('This track could not be loaded.', true);
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    el.durTime.textContent = formatTime(audio.duration);
    const durEl = document.querySelector(`.track-dur[data-dur="${currentIndex}"]`);
    if(durEl) durEl.textContent = formatTime(audio.duration);
  });

  audio.addEventListener('timeupdate', () => {
    if(audio.duration){
      const pct = (audio.currentTime / audio.duration) * 100;
      el.seek.value = pct;
      el.seek.style.setProperty('--fill', pct + '%');
      el.curTime.textContent = formatTime(audio.currentTime);
    }
  });

  audio.addEventListener('ended', () => {
    if(repeatOn){
      audio.currentTime = 0;
      audio.play();
      return;
    }
    if(autoplayOn){
      goNext(true);
    } else {
      setPlaying(false);
    }
  });

  el.seek.addEventListener('input', () => {
    const t = tracks[currentIndex];
    el.seek.style.setProperty('--fill', el.seek.value + '%');
    if(t && t.spotify){
      if(spotifyPlayer && t.durationMs){
        spotifyPlayer.seek((el.seek.value / 100) * t.durationMs);
      }
    } else if(audio.duration){
      audio.currentTime = (el.seek.value / 100) * audio.duration;
    }
  });

  el.volume.addEventListener('input', () => {
    const v = el.volume.value / 100;
    audio.volume = v;
    if(spotifyPlayer) spotifyPlayer.setVolume(v).catch(() => {});
    el.volume.style.setProperty('--vfill', el.volume.value + '%');
  });

  async function removeTrack(index){
    const wasCurrent = index === currentIndex;
    const wasPlaying = isPlaying;
    const removed = tracks[index];
    if(removed.local && removed.src){
      URL.revokeObjectURL(removed.src);
    }
    if(removed.dbId != null){
      try{ await dbDelete(removed.dbId); } catch(e){ console.warn('Could not remove saved track', e); }
    }
    tracks.splice(index, 1);
    if(tracks.length === 0){
      audio.pause();
      audio.src = '';
      setPlaying(false);
      el.title.textContent = "—";
      el.artist.textContent = "—";
      el.durTime.textContent = "0:00";
      el.curTime.textContent = "0:00";
      renderPlaylist();
      return;
    }
    if(wasCurrent){
      const nextIndex = Math.min(index, tracks.length - 1);
      loadTrack(nextIndex, wasPlaying);
    } else {
      if(index < currentIndex) currentIndex--;
      renderPlaylist();
    }
  }

  async function handleFiles(fileList){
    const files = Array.from(fileList).filter(f => f.type.startsWith('audio/') || /\.(mp3|wav|ogg|m4a|flac)$/i.test(f.name));
    if(files.length === 0) return;
    const startIndex = tracks.length;
    for(let i = 0; i < files.length; i++){
      const file = files[i];
      const { artist, title } = parseFileName(file.name);
      const colors = palette[(startIndex + i) % palette.length];
      let dbId = null;
      try{
        dbId = await dbAdd({ kind: 'upload', title, artist, blob: file, colors });
      } catch(e){
        console.warn('Could not save this track for next time', e);
      }
      tracks.push({
        title,
        artist,
        src: URL.createObjectURL(file),
        local: true,
        colors,
        dbId
      });
    }
    renderPlaylist();
    loadTrack(startIndex, true);
  }

  async function restoreLibrary(){
    try{
      const rows = await dbGetAll();
      rows.forEach(row => {
        if(row.kind === 'upload' && row.blob){
          tracks.push({
            title: row.title,
            artist: row.artist,
            src: URL.createObjectURL(row.blob),
            local: true,
            colors: row.colors || palette[tracks.length % palette.length],
            dbId: row.id
          });
        } else if(row.kind === 'online' && row.url){
          tracks.push({
            title: row.title,
            artist: row.artist,
            src: row.url,
            online: true,
            artworkUrl: row.artworkUrl || '',
            colors: row.colors || palette[tracks.length % palette.length],
            dbId: row.id
          });
        } else if(row.kind === 'spotify' && row.uri){
          tracks.push({
            title: row.title,
            artist: row.artist,
            spotify: true,
            uri: row.uri,
            artworkUrl: row.artworkUrl || '',
            durationMs: row.durationMs || 0,
            colors: row.colors || palette[tracks.length % palette.length],
            dbId: row.id
          });
        }
      });
    } catch(e){
      console.warn('Could not restore your saved library this session', e);
    }
  }

  // ---- online search (iTunes Search API — free, no key, returns 30s preview clips) ----
  el.searchToggleBtn.addEventListener('click', () => {
    const showing = el.searchBar.style.display === 'flex';
    el.searchBar.style.display = showing ? 'none' : 'flex';
    if(!showing){
      el.searchInput.focus();
    } else {
      el.searchResults.innerHTML = '';
    }
  });

  async function runSearch(){
    const term = el.searchInput.value.trim();
    if(!term) return;
    el.searchResults.innerHTML = '<div class="search-status">Searching…</div>';

    if(spotifyAccessToken){
      try{
        const items = await searchSpotify(term);
        renderSpotifyResults(items);
      } catch(e){
        el.searchResults.innerHTML = `<div class="search-status">${escapeHtml(e.message || 'Search failed.')}</div>`;
      }
      return;
    }

    try{
      const res = await fetch(`https://itunes.apple.com/search?media=music&limit=8&term=${encodeURIComponent(term)}`);
      const data = await res.json();
      const results = (data.results || []).filter(r => r.previewUrl);
      if(results.length === 0){
        el.searchResults.innerHTML = '<div class="search-status">No previews found for that search.</div>';
        return;
      }
      el.searchResults.innerHTML = '';
      results.forEach(r => {
        const row = document.createElement('div');
        row.className = 'search-result-item';
        const art = r.artworkUrl100 ? r.artworkUrl100.replace('100x100bb', '200x200bb') : '';
        row.innerHTML = `
          ${art ? `<img src="${art}" alt="">` : ''}
          <div class="sr-info">
            <div class="sr-title">${escapeHtml(r.trackName || 'Unknown title')}</div>
            <div class="sr-artist">${escapeHtml(r.artistName || 'Unknown artist')}</div>
          </div>
          <button class="search-add-btn" type="button">Add</button>
        `;
        const btn = row.querySelector('.search-add-btn');
        btn.addEventListener('click', () => {
          btn.disabled = true;
          btn.textContent = 'Added';
          addOnlineTrack(r);
        });
        el.searchResults.appendChild(row);
      });
    } catch(e){
      el.searchResults.innerHTML = '<div class="search-status">Search failed — check your connection.</div>';
    }
  }

  el.searchGoBtn.addEventListener('click', runSearch);
  el.searchInput.addEventListener('keydown', (e) => {
    if(e.key === 'Enter') runSearch();
  });

  async function addOnlineTrack(r){
    const title = r.trackName || 'Unknown title';
    const artist = r.artistName || 'Unknown artist';
    const url = r.previewUrl;
    const artworkUrl = r.artworkUrl100 ? r.artworkUrl100.replace('100x100bb', '300x300bb') : '';
    const colors = palette[tracks.length % palette.length];
    let dbId = null;
    try{
      dbId = await dbAdd({ kind: 'online', title, artist, url, artworkUrl, colors });
    } catch(e){
      console.warn('Could not save this track for next time', e);
    }
    const startIndex = tracks.length;
    tracks.push({ title, artist, src: url, online: true, artworkUrl, colors, dbId });
    renderPlaylist();
    loadTrack(startIndex, true);
  }

  // ---- Spotify integration (Authorization Code + PKCE, Web Playback SDK) ----
  // Requires: your own Spotify Developer Client ID, https/localhost hosting,
  // and a Premium account for actual playback (free accounts can log in but
  // the Web Playback SDK refuses to stream audio for them).
  const SPOTIFY_REDIRECT_URI = window.location.origin + window.location.pathname;
  const SPOTIFY_SCOPES = 'streaming user-read-email user-read-private user-modify-playback-state user-read-playback-state';

  let spotifyAccessToken = sessionStorage.getItem('spotifyAccessToken') || null;
  let spotifyPlayer = null;
  let spotifyDeviceId = null;
  let spotifyPollInterval = null;
  let lastSpotifyPosition = 0;

  function generateRandomString(length){
    const possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let text = '';
    for(let i = 0; i < length; i++) text += possible.charAt(Math.floor(Math.random() * possible.length));
    return text;
  }

  async function sha256(plain){
    const data = new TextEncoder().encode(plain);
    return crypto.subtle.digest('SHA-256', data);
  }

  function base64UrlEncode(buffer){
    return btoa(String.fromCharCode(...new Uint8Array(buffer)))
      .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }

  function updateSpotifyButton(connected){
    el.spotifyBtn.classList.toggle('connected', connected);
    el.spotifyBtnLabel.textContent = connected ? 'Spotify connected' : 'Connect Spotify';
  }

  const CLIENT_ID_PATTERN = /^[0-9a-f]{32}$/i;

  el.spotifyBtn.addEventListener('click', async () => {
    if(spotifyAccessToken){
      disconnectSpotify();
      return;
    }
    let clientId = localStorage.getItem('spotifyClientId');
    if(clientId && !CLIENT_ID_PATTERN.test(clientId)){
      // previously cached value looks wrong (whitespace, wrong field pasted, etc.) — clear it
      clientId = null;
      localStorage.removeItem('spotifyClientId');
    }
    if(!clientId){
      clientId = prompt('Enter your Spotify app Client ID (from developer.spotify.com/dashboard \u2014 the "Client ID" field, not "Client Secret"):');
      if(!clientId) return;
      clientId = clientId.trim();
      if(!CLIENT_ID_PATTERN.test(clientId)){
        alert('That doesn\'t look like a valid Spotify Client ID (should be 32 letters/numbers, no spaces). Double check you copied the Client ID field, not the Client Secret, then try again.');
        return;
      }
      localStorage.setItem('spotifyClientId', clientId);
    }
    const verifier = generateRandomString(64);
    sessionStorage.setItem('spotifyVerifier', verifier);
    const challenge = base64UrlEncode(await sha256(verifier));
    const params = new URLSearchParams({
      client_id: clientId,
      response_type: 'code',
      redirect_uri: SPOTIFY_REDIRECT_URI,
      scope: SPOTIFY_SCOPES,
      code_challenge_method: 'S256',
      code_challenge: challenge
    });
    window.location = `https://accounts.spotify.com/authorize?${params.toString()}`;
  });

  function disconnectSpotify(){
    spotifyAccessToken = null;
    sessionStorage.removeItem('spotifyAccessToken');
    sessionStorage.removeItem('spotifyRefreshToken');
    if(spotifyPlayer){ spotifyPlayer.disconnect(); spotifyPlayer = null; }
    spotifyDeviceId = null;
    stopSpotifyPolling();
    updateSpotifyButton(false);
  }

  async function handleSpotifyRedirect(){
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    if(!code) return;
    const verifier = sessionStorage.getItem('spotifyVerifier');
    const clientId = localStorage.getItem('spotifyClientId');
    window.history.replaceState({}, document.title, window.location.pathname);
    if(!verifier || !clientId) return;
    try{
      const res = await fetch('https://accounts.spotify.com/api/token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          grant_type: 'authorization_code',
          code,
          redirect_uri: SPOTIFY_REDIRECT_URI,
          client_id: clientId,
          code_verifier: verifier
        })
      });
      const data = await res.json();
      if(data.access_token){
        spotifyAccessToken = data.access_token;
        sessionStorage.setItem('spotifyAccessToken', spotifyAccessToken);
        if(data.refresh_token) sessionStorage.setItem('spotifyRefreshToken', data.refresh_token);
      }
    } catch(e){
      console.warn('Spotify authorization failed', e);
    }
  }

  async function refreshSpotifyToken(){
    const refreshToken = sessionStorage.getItem('spotifyRefreshToken');
    const clientId = localStorage.getItem('spotifyClientId');
    if(!refreshToken || !clientId) return false;
    try{
      const res = await fetch('https://accounts.spotify.com/api/token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          grant_type: 'refresh_token',
          refresh_token: refreshToken,
          client_id: clientId
        })
      });
      const data = await res.json();
      if(data.access_token){
        spotifyAccessToken = data.access_token;
        sessionStorage.setItem('spotifyAccessToken', spotifyAccessToken);
        if(data.refresh_token) sessionStorage.setItem('spotifyRefreshToken', data.refresh_token);
        return true;
      }
    } catch(e){
      console.warn('Spotify token refresh failed', e);
    }
    return false;
  }

  window.onSpotifyWebPlaybackSDKReady = () => {
    if(spotifyAccessToken) initSpotifyPlayer();
  };

  function initSpotifyPlayer(){
    if(spotifyPlayer || typeof Spotify === 'undefined') return;
    spotifyPlayer = new Spotify.Player({
      name: 'Web Music Player',
      getOAuthToken: cb => cb(spotifyAccessToken),
      volume: el.volume.value / 100
    });
    spotifyPlayer.addListener('ready', ({ device_id }) => {
      spotifyDeviceId = device_id;
      updateSpotifyButton(true);
    });
    spotifyPlayer.addListener('not_ready', () => { spotifyDeviceId = null; });
    spotifyPlayer.addListener('player_state_changed', handleSpotifyState);
    spotifyPlayer.addListener('initialization_error', ({ message }) => console.warn('Spotify init error', message));
    spotifyPlayer.addListener('authentication_error', ({ message }) => console.warn('Spotify auth error', message));
    spotifyPlayer.addListener('account_error', ({ message }) => console.warn('Spotify Premium is required for playback', message));
    spotifyPlayer.connect();
  }

  function handleSpotifyState(state){
    if(!state) return;
    const t = tracks[currentIndex];
    if(!t || !t.spotify) return;
    const trackEnded = state.paused && state.position === 0 && lastSpotifyPosition > 1000;
    lastSpotifyPosition = state.position;
    el.durTime.textContent = formatTime(state.duration / 1000);
    el.curTime.textContent = formatTime(state.position / 1000);
    if(state.duration){
      const pct = (state.position / state.duration) * 100;
      el.seek.value = pct;
      el.seek.style.setProperty('--fill', pct + '%');
    }
    if(trackEnded){
      if(repeatOn){ playSpotifyTrack(t); }
      else if(autoplayOn){ goNext(true); }
      else { setPlaying(false); }
      return;
    }
    setPlaying(!state.paused);
  }

  function startSpotifyPolling(){
    stopSpotifyPolling();
    spotifyPollInterval = setInterval(async () => {
      if(!spotifyPlayer) return;
      const state = await spotifyPlayer.getCurrentState();
      if(state){
        el.curTime.textContent = formatTime(state.position / 1000);
        if(state.duration){
          const pct = (state.position / state.duration) * 100;
          el.seek.value = pct;
          el.seek.style.setProperty('--fill', pct + '%');
        }
      }
    }, 500);
  }

  function stopSpotifyPolling(){
    if(spotifyPollInterval){ clearInterval(spotifyPollInterval); spotifyPollInterval = null; }
  }

  async function playSpotifyTrack(t){
    if(!spotifyDeviceId){
      alert('Still connecting to Spotify — give it a second and press play again.');
      return false;
    }
    try{
      const res = await fetch(`https://api.spotify.com/v1/me/player/play?device_id=${spotifyDeviceId}`, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${spotifyAccessToken}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ uris: [t.uri] })
      });
      if(res.status === 401){
        const refreshed = await refreshSpotifyToken();
        if(refreshed) return playSpotifyTrack(t);
        disconnectSpotify();
        setStatus('Your Spotify session expired. Reconnect Spotify to continue.', true);
        return false;
      }
      return res.ok;
    } catch(e){
      console.warn('Spotify playback request failed', e);
      setStatus('Spotify playback failed. Please reconnect and try again.', true);
      return false;
    }
  }

  async function searchSpotify(term){
    const url = `https://api.spotify.com/v1/search?type=track&limit=8&q=${encodeURIComponent(term)}`;
    let res = await fetch(url, { headers: { 'Authorization': `Bearer ${spotifyAccessToken}` } });
    if(res.status === 401){
      const refreshed = await refreshSpotifyToken();
      if(refreshed){
        res = await fetch(url, { headers: { 'Authorization': `Bearer ${spotifyAccessToken}` } });
      } else {
        disconnectSpotify();
        throw new Error('Spotify session expired — reconnect and search again.');
      }
    }
    const data = await res.json();
    return (data.tracks && data.tracks.items) || [];
  }

  function renderSpotifyResults(items){
    if(items.length === 0){
      el.searchResults.innerHTML = '<div class="search-status">No results on Spotify for that search.</div>';
      return;
    }
    el.searchResults.innerHTML = '';
    items.forEach(track => {
      const artistNames = (track.artists || []).map(a => a.name).join(', ');
      const artUrl = track.album && track.album.images && track.album.images[1]
        ? track.album.images[1].url
        : (track.album && track.album.images && track.album.images[0] ? track.album.images[0].url : '');
      const row = document.createElement('div');
      row.className = 'search-result-item';
      row.innerHTML = `
        ${artUrl ? `<img src="${artUrl}" alt="">` : ''}
        <div class="sr-info">
          <div class="sr-title">${escapeHtml(track.name || 'Unknown title')}</div>
          <div class="sr-artist">${escapeHtml(artistNames || 'Unknown artist')}</div>
        </div>
        <button class="search-add-btn" type="button">Add</button>
      `;
      const btn = row.querySelector('.search-add-btn');
      btn.addEventListener('click', () => {
        btn.disabled = true;
        btn.textContent = 'Added';
        addSpotifyTrack(track, artUrl, artistNames);
      });
      el.searchResults.appendChild(row);
    });
  }

  async function addSpotifyTrack(track, artUrl, artistNames){
    const title = track.name || 'Unknown title';
    const artist = artistNames || 'Unknown artist';
    const uri = track.uri;
    const durationMs = track.duration_ms || 0;
    const colors = palette[tracks.length % palette.length];
    let dbId = null;
    try{
      dbId = await dbAdd({ kind: 'spotify', title, artist, uri, artworkUrl: artUrl, durationMs, colors });
    } catch(e){
      console.warn('Could not save this track for next time', e);
    }
    const startIndex = tracks.length;
    tracks.push({ title, artist, spotify: true, uri, artworkUrl: artUrl, durationMs, colors, dbId });
    renderPlaylist();
    loadTrack(startIndex, true);
  }

  el.fileUpload.addEventListener('change', (e) => {
    handleFiles(e.target.files);
    e.target.value = '';
  });

  (async function init(){
    el.volume.style.setProperty('--vfill', el.volume.value + '%');
    audio.volume = el.volume.value / 100;
    await handleSpotifyRedirect();
    if(spotifyAccessToken){
      updateSpotifyButton(true);
      if(typeof Spotify !== 'undefined') initSpotifyPlayer();
    }
    await restoreLibrary();
    renderPlaylist();
    loadTrack(0, false);
  })();
</script>

</body>
</html>
